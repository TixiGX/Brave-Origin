<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.BraveOrigin" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bo_bg</item>
        <item name="android:statusBarColor">@color/bo_frame</item>
        <item name="android:navigationBarColor">@color/bo_surface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorPrimary">@color/bo_surface</item>
        <item name="android:colorPrimaryDark">@color/bo_frame</item>
        <item name="android:colorAccent">@color/bo_shields</item>
        <item name="android:colorControlActivated">@color/bo_shields</item>
        <item name="android:textColorPrimary">@color/bo_text</item>
        <item name="android:textColorSecondary">@color/bo_text_dim</item>
        <item name="android:textColorHint">@color/bo_text_dim</item>
        <item name="android:alertDialogTheme">@style/Theme.BraveOrigin.Dialog</item>
    </style>

    <style name="Theme.BraveOrigin.Dialog" parent="@android:style/Theme.Material.Dialog">
        <item name="android:windowBackground">@drawable/bg_dialog_surface</item>
        <item name="android:colorAccent">@color/bo_shields</item>
        <item name="android:textColorPrimary">@color/bo_text</item>
        <item name="android:textColorSecondary">@color/bo_text_dim</item>
    </style>

    <style name="BoIconButton">
        <item name="android:layout_width">38dp</item>
        <item name="android:layout_height">38dp</item>
        <item name="android:padding">9dp</item>
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
        <item name="android:tint">@color/bo_text</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <style name="BoOmniIconButton">
        <item name="android:layout_width">32dp</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:padding">7dp</item>
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
        <item name="android:tint">@color/bo_text_dim</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <style name="BoUrlInput">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@null</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">6dp</item>
        <item name="android:textColor">@color/bo_text</item>
        <item name="android:textColorHint">@color/bo_text_dim</item>
        <item name="android:textSize">13.5sp</item>
        <item name="android:singleLine">true</item>
        <item name="android:maxLines">1</item>
        <item name="android:inputType">textUri|textNoSuggestions</item>
        <item name="android:imeOptions">actionGo|flagNoExtractUi</item>
        <item name="android:selectAllOnFocus">true</item>
    </style>
</resources>
