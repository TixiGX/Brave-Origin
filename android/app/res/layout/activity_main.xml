<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_frame"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bo_bg">

    <LinearLayout
        android:id="@+id/browser_chrome_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Desktop Tab Strip -->
        <LinearLayout
            android:id="@+id/tab_strip_bar"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:background="@color/bo_frame"
            android:gravity="bottom"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingTop="4dp"
            android:paddingEnd="4dp">

            <LinearLayout
                android:id="@+id/private_badge"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_chip"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:src="@drawable/ic_incognito"
                    android:tint="@color/bo_private_accent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="Privata"
                    android:textColor="@color/bo_private_accent"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <HorizontalScrollView
                android:id="@+id/tab_strip_scroll"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:fillViewport="false"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/tab_strip_container"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="bottom"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <ImageButton
                android:id="@+id/btn_new_tab_strip"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="2dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/new_tab"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_add"
                android:tint="@color/bo_text_dim" />
        </LinearLayout>

        <!-- Top Toolbar Slot -->
        <FrameLayout
            android:id="@+id/top_toolbar_slot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/omnibox_bar"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="@color/bo_surface"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="3dp"
                android:paddingEnd="4dp">

                <ImageButton
                    android:id="@+id/btn_back"
                    style="@style/BoIconButton"
                    android:contentDescription="@string/back"
                    android:src="@drawable/ic_back" />

                <ImageButton
                    android:id="@+id/btn_forward"
                    style="@style/BoIconButton"
                    android:contentDescription="@string/forward"
                    android:src="@drawable/ic_forward" />

                <ImageButton
                    android:id="@+id/btn_reload"
                    style="@style/BoIconButton"
                    android:contentDescription="@string/reload"
                    android:src="@drawable/ic_reload" />

                <ImageButton
                    android:id="@+id/btn_home"
                    style="@style/BoIconButton"
                    android:contentDescription="@string/home"
                    android:src="@drawable/ic_home" />

                <!-- Omnibox Pill -->
                <LinearLayout
                    android:id="@+id/omnibox_pill"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_url_bar"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp">

                    <ImageButton
                        android:id="@+id/btn_site_info"
                        style="@style/BoOmniIconButton"
                        android:contentDescription="Info sito"
                        android:src="@drawable/ic_brave_lion" />

                    <EditText
                        android:id="@+id/url_bar"
                        style="@style/BoUrlInput"
                        android:hint="@string/url_hint"
                        android:importantForAutofill="no"
                        android:scrollHorizontally="true" />

                    <ImageButton
                        android:id="@+id/btn_url_clear"
                        style="@style/BoOmniIconButton"
                        android:contentDescription="Cancella testo"
                        android:src="@drawable/ic_close"
                        android:visibility="gone" />

                    <ImageButton
                        android:id="@+id/btn_reader"
                        style="@style/BoOmniIconButton"
                        android:contentDescription="@string/reader"
                        android:src="@drawable/ic_reader"
                        android:visibility="gone" />

                    <ImageButton
                        android:id="@+id/btn_bookmark"
                        style="@style/BoOmniIconButton"
                        android:contentDescription="@string/bookmark"
                        android:src="@drawable/ic_star_outline" />
                </LinearLayout>

                <!-- Brave Shields Lion + Counter Pill -->
                <LinearLayout
                    android:id="@+id/btn_shields"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="3dp"
                    android:background="@drawable/bg_shields_pill"
                    android:clickable="true"
                    android:contentDescription="@string/shields"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="7dp"
                    android:paddingEnd="7dp">

                    <ImageView
                        android:id="@+id/img_shields"
                        android:layout_width="17dp"
                        android:layout_height="17dp"
                        android:src="@drawable/ic_brave_lion"
                        android:tint="@color/bo_shields" />

                    <TextView
                        android:id="@+id/txt_shields_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="0"
                        android:textColor="@color/bo_text"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Tab Switcher Counter -->
                <TextView
                    android:id="@+id/btn_tabs_overview"
                    android:layout_width="28dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"
                    android:background="@drawable/bg_tab_count"
                    android:clickable="true"
                    android:contentDescription="@string/tabs"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="@color/bo_text"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <!-- Desktop Menu Button -->
                <ImageButton
                    android:id="@+id/btn_menu"
                    style="@style/BoIconButton"
                    android:contentDescription="@string/menu"
                    android:src="@drawable/ic_menu" />
            </LinearLayout>
        </FrameLayout>

        <!-- Desktop Bookmarks Bar -->
        <LinearLayout
            android:id="@+id/bookmarks_bar_row"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:background="@color/bo_surface"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <HorizontalScrollView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/bookmarks_bar_container"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </LinearLayout>

        <View
            android:id="@+id/toolbar_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/bo_stroke" />

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:max="100"
            android:progress="0"
            android:progressBackgroundTint="@color/bo_surface"
            android:progressTint="@color/bo_shields"
            android:visibility="gone" />

        <!-- Find in Page Bar -->
        <LinearLayout
            android:id="@+id/find_bar"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="@color/bo_surface_elevated"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="6dp"
            android:visibility="gone">

            <EditText
                android:id="@+id/find_input"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Trova nella pagina…"
                android:imeOptions="actionSearch|flagNoExtractUi"
                android:importantForAutofill="no"
                android:inputType="text"
                android:singleLine="true"
                android:textColor="@color/bo_text"
                android:textColorHint="@color/bo_text_dim"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/find_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:text="0/0"
                android:textColor="@color/bo_text_dim"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btn_find_prev"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="▲"
                android:textColor="@color/bo_text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btn_find_next"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="▼"
                android:textColor="@color/bo_text"
                android:textSize="13sp" />

            <ImageButton
                android:id="@+id/btn_find_close"
                style="@style/BoOmniIconButton"
                android:contentDescription="Chiudi ricerca"
                android:src="@drawable/ic_close" />
        </LinearLayout>

        <!-- Central WebView + Omnibox Autocomplete Overlay -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <FrameLayout
                android:id="@+id/webview_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/bo_bg" />

            <!-- Autocomplete Suggestions Overlay -->
            <LinearLayout
                android:id="@+id/omnibox_suggestions_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:background="@drawable/bg_dialog_surface"
                android:elevation="8dp"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Integrated Desktop DevTools Panel -->
        <LinearLayout
            android:id="@+id/devtools_panel"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:background="@color/bo_frame"
            android:orientation="vertical"
            android:visibility="gone">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/bo_stroke" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:background="@color/bo_surface"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="4dp">

                <TextView
                    android:id="@+id/dev_tab_console"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="Console"
                    android:textColor="@color/bo_shields"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/dev_tab_elements"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="Elementi"
                    android:textColor="@color/bo_text_dim"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/dev_tab_network"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="Scudi / Rete"
                    android:textColor="@color/bo_text_dim"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/dev_tab_storage"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="Archiviazione"
                    android:textColor="@color/bo_text_dim"
                    android:textSize="12sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/btn_dev_clear"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="Pulisci"
                    android:textColor="@color/bo_text_dim"
                    android:textSize="11sp" />

                <ImageButton
                    android:id="@+id/btn_dev_close"
                    style="@style/BoOmniIconButton"
                    android:contentDescription="Chiudi DevTools"
                    android:src="@drawable/ic_close" />
            </LinearLayout>

            <ScrollView
                android:id="@+id/devtools_scroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:padding="8dp">

                <TextView
                    android:id="@+id/devtools_output"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="#FFE2E8F0"
                    android:textIsSelectable="true"
                    android:textSize="11.5sp" />
            </ScrollView>

            <LinearLayout
                android:id="@+id/devtools_repl_row"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:background="@color/bo_surface"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="&gt; "
                    android:textColor="@color/bo_shields"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/devtools_input"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:fontFamily="monospace"
                    android:hint="Valuta JavaScript nella pagina…"
                    android:imeOptions="actionSend|flagNoExtractUi"
                    android:importantForAutofill="no"
                    android:inputType="textNoSuggestions"
                    android:singleLine="true"
                    android:textColor="@color/bo_text"
                    android:textColorHint="@color/bo_text_dim"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btn_dev_run"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="Esegui"
                    android:textColor="@color/bo_text"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Bottom Toolbar Slot (when Bottom Bar mode is enabled) -->
        <FrameLayout
            android:id="@+id/bottom_toolbar_slot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- Fullscreen Video Container -->
    <FrameLayout
        android:id="@+id/fullscreen_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF000000"
        android:visibility="gone" />
</FrameLayout>
