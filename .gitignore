# Binari di installazione oltre il limite GitHub di 100 MB per file:
# pubblicati come asset della GitHub Release.
installers/**/*.exe
installers/**/*.dmg
installers/**/*.apk
dist/
build/

# Keystore locale di firma APK (generato automaticamente in build/CI)
.keystore/
*.jks
*.keystore
*.idsig

# Cache Python
__pycache__/
*.pyc
